# Local configuration. Export these variables before go run ./cmd/service.
# The service does not automatically load dotenv files.
APP_LISTEN_ADDR=127.0.0.1:{{ .Runtime.Port }}
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s
{{ if .Settings.workflow }}
# Empty Temporal registry: no connection, polling, or automatic execution.
TEMPORAL_HOSTPORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=service
TEMPORAL_DIAL_TIMEOUT=5s
TEMPORAL_WORKER_STOP_TIMEOUT=5s
{{ end }}
