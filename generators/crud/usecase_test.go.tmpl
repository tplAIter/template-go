func (r *inMem{{ .Name.Pascal }}Repo) Update(_ context.Context, entity *{{ .Name.Pascal }}Entity) (bool, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[entity.ID]; !ok {
		return false, nil
	}
	r.items[entity.ID] = *entity
	return true, nil
}

func (r *inMem{{ .Name.Pascal }}Repo) Delete(_ context.Context, id string) (bool, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[id]; !ok {
