// Package memory содержит in-memory реализации портов хранилища.
//
// Используется в конфигурациях без PostgreSQL и в юнит-тестах как «настоящий»
// адаптер (вместо мока): та же семантика lock → read → write, но на map под
// мьютексом. Продовый адаптер поверх gocore/postgres реализует те же порты.
package memory

import (
	"context"
	"sync"
	"time"

	"{{ .Project.Module }}/internal/usecase"
)

// ExampleRepo — потокобезопасное in-memory хранилище примеров.
type ExampleRepo struct {
	mu      sync.Mutex
	byEmail map[string]usecase.ExampleEntity
}

// NewExampleRepo создаёт пустой репозиторий.
func NewExampleRepo() *ExampleRepo {
	return &ExampleRepo{byEmail: make(map[string]usecase.ExampleEntity)}
}

// WithinTx сериализует сценарий под мьютексом (аналог транзакции + advisory-лока).
func (r *ExampleRepo) WithinTx(ctx context.Context, fn func(ctx context.Context) error) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	return fn(ctx)
}

// LockByEmail — no-op: сериализацию обеспечивает мьютекс WithinTx.
func (r *ExampleRepo) LockByEmail(_ context.Context, _ string) error { return nil }

// FindByEmail возвращает запись или (nil, nil).
func (r *ExampleRepo) FindByEmail(_ context.Context, email string) (*usecase.ExampleEntity, error) {
	if e, ok := r.byEmail[email]; ok {
		clone := e
		return &clone, nil
	}
	return nil, nil
}

// CountCreatedSince считает записи, созданные не раньше t.
func (r *ExampleRepo) CountCreatedSince(_ context.Context, t time.Time) (int64, error) {
	var n int64
	for _, e := range r.byEmail {
		if !e.CreatedAt.Before(t) {
			n++
		}
	}
	return n, nil
}

// Create сохраняет новую запись.
func (r *ExampleRepo) Create(_ context.Context, entity *usecase.ExampleEntity) error {
	r.byEmail[entity.Email] = *entity
	return nil
}
