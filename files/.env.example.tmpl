# Example configuration for {{ .Project.Name }} for local execution (go run ./cmd/app).
# Copy to .env and set the values. See internal/config for defaults.

APP_NAME={{ .Project.Slug }}
APP_HOST=0.0.0.0
APP_PORT={{ .Runtime.Port }}
APP_DEBUG=true

LOGGER__LEVEL=debug
LOGGER__LOG_TYPE=text
# LOGGER__STORAGE_TYPE=siem

# Pod/image label for the stack_info dashboard (optional, gocore/httpserver);
# Kubernetes supplies it through the Downward API, and empty is valid. See docs/monitoring.md#siem.
# POD_NODE=
# POD_IMAGE=

# OpenTelemetry (optional, pkg/gocore/otel). An empty or absent
# OTEL_EXPORTER_OTLP_ENDPOINT disables tracing (no-op). Uncomment and provide
# an OTLP/HTTP collector URL with its scheme to enable it locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME={{ .Project.Slug }}
# OTEL_EXPORTER_OTLP_INSECURE=true
{{- if is "database" "postgres" }}

POSTGRES__DB_HOST=localhost
POSTGRES__DB_PORT=5432
POSTGRES__DB_NAME={{ .Project.Slug }}
POSTGRES__DB_USER={{ .Project.Slug }}
POSTGRES__DB_PASSWORD={{ .Project.Slug }}
POSTGRES__SSL_MODE=disable
POSTGRES__SCHEMA=data
POSTGRES__POOL__MAX_SIZE=10
{{- end }}
{{- if .Settings.cache }}

REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__SSL_ENABLE=false
{{- end }}
{{- if .Settings.storage }}

S3__HOST=localhost:9000
S3__ACCESS_KEY={{ .Project.Slug }}_username
S3__SECRET_KEY={{ .Project.Slug }}_password
S3__BUCKET={{ .Project.Slug }}
S3__REGION=us-east-1
S3__USE_SSL=false
{{- end }}
{{- if has "brokers" "kafka" }}

KAFKA__BOOTSTRAP_SERVERS=localhost:9092
KAFKA__CLIENT_ID={{ .Project.Slug }}
KAFKA__CONSUMER_GROUP={{ .Project.Slug }}
KAFKA__EXAMPLE_TOPIC={{ .Project.Kebab }}.examples
{{- end }}
{{- if .Settings.kafka_ssl }}

# Inline PEM (line breaks are literal \n), or leave empty for plaintext.
KAFKA__SSL__CA_PEM=
KAFKA__SSL__CERT_PEM=
KAFKA__SSL__KEY_PEM=
KAFKA__SSL__SKIP_VERIFY=false
{{- end }}
{{- if has "brokers" "rabbitmq" }}

RABBITMQ__URL=amqp://{{ .Project.Slug }}:{{ .Project.Slug }}@localhost:5672/
RABBITMQ__EXAMPLE_EXCHANGE={{ .Project.Kebab }}
RABBITMQ__EXAMPLE_QUEUE={{ .Project.Kebab }}.examples
{{- end }}
{{- if .Settings.workflow }}

TEMPORAL__HOSTPORT=localhost:7233
TEMPORAL__NAMESPACE=default
TEMPORAL__TASK_QUEUE={{ .Project.Kebab }}
{{- end }}

# Infrastructure host-port overrides (docker compose).
# Published infrastructure ports are parameterized as
# "${GOTMPL_<SERVICE>_PORT:-<default>}". Uncomment what you need if a default
# port is occupied on the host; only the published (left) side changes — ports
# inside the compose network stay unchanged. Remember to synchronize the client
# addresses above (POSTGRES__DB_PORT, KAFKA__BOOTSTRAP_SERVERS, etc.).
{{- if is "database" "postgres" }}
# GOTMPL_PG_PORT=5432
# GOTMPL_PGADMIN_PORT=8088
{{- end }}
{{- if .Settings.cache }}
# GOTMPL_REDIS_PORT=6379
{{- end }}
