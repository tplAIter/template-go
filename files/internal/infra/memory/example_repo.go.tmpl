// Package memory contains in-memory implementations of storage ports.
//
// Used in configurations without PostgreSQL and in unit tests as a real adapter
// (rather than a mock): the same lock → read → write semantics, backed by a map
// protected by a mutex. The production gocore/postgres adapter implements the
// same ports.
package memory

import (
	"context"
	"sync"
	"time"

	"{{ .Project.Module }}/internal/usecase"
)

// ExampleRepo — thread-safe in-memory example store.
type ExampleRepo struct {
	mu      sync.Mutex
	byEmail map[string]usecase.ExampleEntity
}

// NewExampleRepo creates an empty repository.
func NewExampleRepo() *ExampleRepo {
	return &ExampleRepo{byEmail: make(map[string]usecase.ExampleEntity)}
}

// WithinTx serializes a use case under the mutex (the equivalent of a
// transaction plus an advisory lock).
func (r *ExampleRepo) WithinTx(ctx context.Context, fn func(ctx context.Context) error) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	return fn(ctx)
}

// LockByEmail — no-op: WithinTx's mutex provides serialization.
func (r *ExampleRepo) LockByEmail(_ context.Context, _ string) error { return nil }

// FindByEmail returns a record or (nil, nil).
func (r *ExampleRepo) FindByEmail(_ context.Context, email string) (*usecase.ExampleEntity, error) {
	if e, ok := r.byEmail[email]; ok {
		clone := e
		return &clone, nil
	}
	return nil, nil
}

// CountCreatedSince counts records created no earlier than t.
func (r *ExampleRepo) CountCreatedSince(_ context.Context, t time.Time) (int64, error) {
	var n int64
	for _, e := range r.byEmail {
		if !e.CreatedAt.Before(t) {
			n++
		}
	}
	return n, nil
}

// Create stores a new record.
func (r *ExampleRepo) Create(_ context.Context, entity *usecase.ExampleEntity) error {
	r.byEmail[entity.Email] = *entity
	return nil
}
