# docker-compose for local development of {{ .Project.Name }}.
#
# The file is ASSEMBLED from templates/service/partials/fragment-*.yaml.tmpl
# during generation (see docs/monitoring.md in the go-template repository).
# backend, prometheus, grafana, and node-exporter are always included; features
# add their own services, while optional stacks are enabled through profiles:
# docker compose --profile obs|elk|pyroscope|parca|graylog up.
name: {{ .Project.Slug }}

services:
{{- if is "database" "postgres" }}
{{ template "compose.postgresql" . }}
{{- end }}
{{- if .Settings.cache }}
{{ template "compose.redis" . }}
{{- end }}
{{- if has "brokers" "kafka" }}
{{ template "compose.kafka" . }}
{{- end }}
{{- if has "brokers" "rabbitmq" }}
{{ template "compose.rabbitmq" . }}
{{- end }}
{{- if .Settings.storage }}
{{ template "compose.minio" . }}
{{- end }}
{{- if .Settings.workflow }}
{{ template "compose.temporal" . }}
{{- end }}
{{ template "compose.prometheus" . }}
{{ template "compose.grafana" . }}
{{ template "compose.node-exporter" . }}
{{ template "compose.loki" . }}
{{ template "compose.alloy" . }}
{{ template "compose.pyroscope" . }}
{{ template "compose.parca" . }}
