// Package tests contains unit and e2e tests for service {{ .Project.Name }}.
//
// Unit tests run the use case through a real in-memory adapter (not a mock),
// checking domain logic without infrastructure. e2e tests (e2e_test.go) start
// the production app.New factory through httptest.
package tests

import (
	"context"
	"io"
	"log/slog"
	"testing"

	"{{ .Project.Module }}/internal/infra/memory"
	"{{ .Project.Module }}/internal/usecase"
)

func testLogger() *slog.Logger {
	return slog.New(slog.NewTextHandler(io.Discard, nil))
}

func TestCreateExampleUseCase(t *testing.T) {
	tests := []struct {
		name     string
		seedSame bool
		req      usecase.CreateExampleRequest
		wantCode usecase.CreateExampleCode
	}{
		{
			name:     "valid creates",
			req:      usecase.CreateExampleRequest{Name: "Alice", Email: "alice@example.com"},
			wantCode: usecase.CreateExampleOK,
		},
		{
			name:     "duplicate email",
			seedSame: true,
			req:      usecase.CreateExampleRequest{Name: "Bob", Email: "bob@example.com"},
			wantCode: usecase.CreateExampleAlreadyExists,
		},
		{
			name:     "invalid email",
			req:      usecase.CreateExampleRequest{Name: "Carol", Email: "not-an-email"},
			wantCode: usecase.CreateExampleInvalid,
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			repo := memory.NewExampleRepo()
			uc := usecase.NewCreateExampleUseCase(repo, testLogger())
			ctx := context.Background()

			if tc.seedSame {
				if got := uc.Execute(ctx, tc.req); got.Code != usecase.CreateExampleOK {
					t.Fatalf("seed create code = %v, want OK", got.Code)
				}
			}

			resp := uc.Execute(ctx, tc.req)
			if resp.Code != tc.wantCode {
				t.Fatalf("code = %v, want %v", resp.Code, tc.wantCode)
			}
			if resp.Code == usecase.CreateExampleOK && resp.Result == nil {
				t.Error("expected non-nil result on success")
			}
		})
	}
}
