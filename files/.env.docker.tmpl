# Конфигурация backend-контейнера в docker compose: хосты — имена сервисов сети compose.
# Файл подключается через env_file (см. фрагмент compose.backend).

APP_NAME={{ .Project.Slug }}
APP_HOST=0.0.0.0
APP_PORT={{ .Runtime.Port }}
APP_DEBUG=true

LOGGER__LEVEL=debug
LOGGER__LOG_TYPE=json
{{- if is "database" "postgres" }}

POSTGRES__DB_HOST=postgres
POSTGRES__DB_PORT=5432
POSTGRES__DB_NAME={{ .Project.Slug }}
POSTGRES__DB_USER={{ .Project.Slug }}
POSTGRES__DB_PASSWORD={{ .Project.Slug }}
POSTGRES__SSL_MODE=disable
{{- end }}
{{- if .Settings.cache }}

REDIS__HOST=redis
REDIS__PORT=6379
{{- end }}
{{- if .Settings.storage }}

S3__HOST=minio:9000
S3__ACCESS_KEY={{ .Project.Slug }}_username
S3__SECRET_KEY={{ .Project.Slug }}_password
S3__BUCKET={{ .Project.Slug }}
S3__USE_SSL=false
{{- end }}
{{- if has "brokers" "kafka" }}

KAFKA__BOOTSTRAP_SERVERS=kafka:9092
KAFKA__CLIENT_ID={{ .Project.Slug }}
KAFKA__CONSUMER_GROUP={{ .Project.Slug }}
{{- end }}
{{- if has "brokers" "rabbitmq" }}

RABBITMQ__URL=amqp://{{ .Project.Slug }}:{{ .Project.Slug }}@rabbitmq:5672/
{{- end }}
{{- if .Settings.workflow }}

TEMPORAL__HOSTPORT=temporal:7233
TEMPORAL__NAMESPACE=default
TEMPORAL__TASK_QUEUE={{ .Project.Kebab }}
{{- end }}
