package usecase

import (
	"context"
	"log/slog"
	"strings"
	"time"
)

type ExampleEntity struct { ID, Name, Email string; CreatedAt time.Time }

type ExampleRepository interface {
	CountCreatedSince(context.Context, time.Time) (int64, error)
	Create(context.Context, *ExampleEntity) error
	FindByEmail(context.Context, string) (*ExampleEntity, error)
	LockByEmail(context.Context, string) error
	WithinTx(context.Context, func(context.Context) error) error
}

type CreateExampleRequest struct { Name, Email string }
type CreateExampleCode int
const (
	CreateExampleOK CreateExampleCode = iota
	CreateExampleAlreadyExists
	CreateExampleInvalid
	CreateExampleRateLimited
	CreateExampleError
)
type CreateExampleResponse struct { Code CreateExampleCode; Result *ExampleEntity; Err error }

type CreateExampleUseCase struct { repo ExampleRepository; logger *slog.Logger }
func NewCreateExampleUseCase(repo ExampleRepository, logger *slog.Logger) *CreateExampleUseCase {
	if logger == nil { logger = slog.Default() }
	return &CreateExampleUseCase{repo: repo, logger: logger}
}
func (u *CreateExampleUseCase) Execute(ctx context.Context, req CreateExampleRequest) CreateExampleResponse {
	if strings.TrimSpace(req.Name) == "" || !strings.Contains(req.Email, "@") { return CreateExampleResponse{Code: CreateExampleInvalid} }
	var result CreateExampleResponse
	err := u.repo.WithinTx(ctx, func(tx context.Context) error {
		if err := u.repo.LockByEmail(tx, req.Email); err != nil { return err }
		found, err := u.repo.FindByEmail(tx, req.Email); if err != nil { return err }
		if found != nil { result = CreateExampleResponse{Code: CreateExampleAlreadyExists, Result: found}; return nil }
		entity := &ExampleEntity{ID: req.Email, Name: req.Name, Email: req.Email, CreatedAt: time.Now().UTC()}
		if err := u.repo.Create(tx, entity); err != nil { return err }
		result = CreateExampleResponse{Code: CreateExampleOK, Result: entity}; return nil
	})
	if err != nil { u.logger.Error("create example", "error", err); return CreateExampleResponse{Code: CreateExampleError, Err: err} }
	return result
}
