}

func (r *inMem{{ .Name.Pascal }}Repo) List(_ context.Context, limit, offset int) ([]{{ .Name.Pascal }}Entity, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	out := make([]{{ .Name.Pascal }}Entity, 0, len(r.items))
	for _, e := range r.items {
		out = append(out, e)
	}
	if offset >= len(out) {
		return nil, nil
	}
	out = out[offset:]
	if limit > 0 && limit < len(out) {
		out = out[:limit]
	}
	return out, nil
}

